<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_panel">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="StanControl"
            android:textColor="#F2F4F5"
            android:textSize="19sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/row_minus"
            android:layout_width="34dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="−"
            android:textColor="#E7EDF0"
            android:textSize="22sp"
            android:background="@drawable/widget_key"/>
        <TextView
            android:id="@+id/widget_rows"
            android:layout_width="76dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="15 СЛОЁВ"
            android:textColor="#F08AB8"
            android:textSize="11sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/row_plus"
            android:layout_width="34dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="+"
            android:textColor="#E7EDF0"
            android:textSize="21sp"
            android:background="@drawable/widget_key"/>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_last_pack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Пока нет пачек"
        android:textColor="#E8DCE3"
        android:textSize="14sp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"/>

    <TextView
        android:id="@+id/widget_weight"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:gravity="center_vertical|end"
        android:text="Вес, кг"
        android:textSize="27sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="@drawable/widget_display"/>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="4"
        android:useDefaultMargins="true">
        <TextView android:id="@+id/key_7" android:text="7" style="@style/WidgetKey"/>
        <TextView android:id="@+id/key_8" android:text="8" style="@style/WidgetKey"/>
        <TextView android:id="@+id/key_9" android:text="9" style="@style/WidgetKey"/>
        <TextView android:id="@+id/key_4" android:text="4" style="@style/WidgetKey"/>
        <TextView android:id="@+id/key_5" android:text="5" style="@style/WidgetKey"/>
        <TextView android:id="@+id/key_6" android:text="6" style="@style/WidgetKey"/>
        <TextView android:id="@+id/key_1" android:text="1" style="@style/WidgetKey"/>
        <TextView android:id="@+id/key_2" android:text="2" style="@style/WidgetKey"/>
        <TextView android:id="@+id/key_3" android:text="3" style="@style/WidgetKey"/>
        <TextView android:id="@+id/key_del" android:text="⌫" style="@style/WidgetKey"/>
        <TextView android:id="@+id/key_0" android:text="0" style="@style/WidgetKey"/>
        <TextView android:id="@+id/key_clear" android:text="C" style="@style/WidgetKey"/>
    </GridLayout>

    <TextView
        android:id="@+id/widget_add"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:gravity="center"
        android:text="ДОБАВИТЬ ПАЧКУ"
        android:textColor="#171A1C"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginTop="7dp"
        android:background="@drawable/widget_add"/>
    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="СМЕНА ОТКРЫТА"
        android:textColor="#D9B9CA"
        android:textSize="10sp"
        android:paddingTop="5dp"/>
</LinearLayout>
